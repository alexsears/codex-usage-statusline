+fn usage_status_style(item: StatusLineItem, text: &str) -> Option<Style> {
+    if !matches!(
+        item,
+        StatusLineItem::ContextUsed | StatusLineItem::FiveHourLimit | StatusLineItem::WeeklyLimit
+    ) {
+        return None;
+    }
+
+    let percent = text
+        .split_whitespace()
+        .find_map(|part| part.strip_suffix('%'))?
+        .parse::<f64>()
+        .ok()?;
+    let percent_used = if matches!(
+        item,
+        StatusLineItem::FiveHourLimit | StatusLineItem::WeeklyLimit
+    ) {
+        100.0 - percent
+    } else {
+        percent
+    };
+    let color = if percent_used >= 85.0 {
+        Color::Red
+    } else if percent_used >= 60.0 {
+        Color::Yellow
+    } else {
+        Color::Rgb(196, 181, 253)
+    };
+    Some(Style::default().fg(color))
+}
